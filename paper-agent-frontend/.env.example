# 数据模式：mock（默认，离线可完整演示） | live（对接 BFF）
VITE_API_MODE=mock

# Live 模式下 BFF 根地址（后端文档 §8：统一前缀 /api/v1，仅绑定 127.0.0.1）
# 8787 = 后端 config.ts 的 PAPER_AGENT_PORT 默认值
VITE_API_BASE_URL=http://127.0.0.1:8787
# 跨域：BFF 默认只放行 http://127.0.0.1:5173，而本地 dev server 跑在 5174，
# 启动后端时需覆盖：PAPER_AGENT_CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

# AGH 原生设置入口（设置页跳转用；留空则界面给出可读说明，不显示假按钮）
VITE_AGH_SETTINGS_URL=

# 演示辅助开关：on 时在监控页提供「模拟断线」等验证控件（仅 mock 模式生效）
VITE_FLAG_DEMO_TOOLS=on
