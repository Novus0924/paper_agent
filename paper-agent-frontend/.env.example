# 数据模式：mock（默认，离线可完整演示） | live（对接 BFF）
VITE_API_MODE=mock

# Live 模式下 BFF 根地址（后端文档 §8：统一前缀 /api/v1，仅绑定 127.0.0.1）
# 联调建议留空 = 同源：请求走 vite 的 server.proxy['/api'] → 127.0.0.1:8787。
# 写死 http://127.0.0.1:8787 时 JSON 接口可用（需后端 PAPER_AGENT_CORS_ORIGINS 放行 5174），
# 但 SSE 仍连不上：events 路由 reply.hijack() 后自己 writeHead，响应头里没有 Access-Control-Allow-Origin。
VITE_API_BASE_URL=

# AGH 原生设置入口（设置页跳转用；留空则界面给出可读说明，不显示假按钮）
VITE_AGH_SETTINGS_URL=

# 演示辅助开关：on 时在监控页提供「模拟断线」等验证控件（仅 mock 模式生效）
VITE_FLAG_DEMO_TOOLS=on
