# 数据模式：mock（默认，离线可完整演示） | live（对接 BFF）
VITE_API_MODE=mock

# Live 模式下 BFF 根地址（后端文档 §8：统一前缀 /api/v1，仅绑定 127.0.0.1）
# 留空（默认）= 同源：请求走 vite 的 server.proxy['/api'] → 127.0.0.1:8787。
# 写 http://127.0.0.1:8787 = 直连跨源：JSON 与 SSE 都可用，但 Origin 必须在后端白名单里
# （bff/src/infra/cors.ts 默认已含 5173/5174；其余端口用 PAPER_AGENT_CORS_ORIGINS 追加）。
# 注意 SSE 的白名单由 cors.ts 统一供给：events 路由 reply.hijack() 后自己 writeHead，
# 走不到 app 级钩子——这一处曾漏发 Access-Control-Allow-Origin，表现为"JSON 正常、SSE 一帧不到"。
VITE_API_BASE_URL=

# AGH 原生设置入口（设置页跳转用；留空则界面给出可读说明，不显示假按钮）
VITE_AGH_SETTINGS_URL=

# 演示辅助开关：on 时在监控页提供「模拟断线」等验证控件（仅 mock 模式生效）
VITE_FLAG_DEMO_TOOLS=on
